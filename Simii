from flask import Flask, request, jsonify, render_template_string
import sqlite3
import uuid
import os

app = Flask(__name__)

DB = "simmiii.db"
UPLOAD_FOLDER = "uploads"

os.makedirs(UPLOAD_FOLDER, exist_ok=True)


# =========================
# DATABASE
# =========================

def get_db():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con


def setup():

    con = get_db()

    con.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            simmiii_id TEXT UNIQUE
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sender TEXT,
            receiver TEXT,
            status TEXT DEFAULT 'pending'
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS friends (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user1 TEXT,
            user2 TEXT
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sender TEXT,
            receiver TEXT,
            message TEXT,
            photo TEXT
        )
    """)

    con.commit()
    con.close()


# =========================
# CREATE USER
# =========================

@app.route("/create_user")
def create_user():

    user_id = "SIM-" + uuid.uuid4().hex[:8].upper()

    con = get_db()

    con.execute(
        "INSERT INTO users (simmiii_id) VALUES (?)",
        (user_id,)
    )

    con.commit()
    con.close()

    return jsonify({
        "success": True,
        "id": user_id
    })


# =========================
# SEARCH USER
# =========================

@app.route("/search_user/<user_id>")
def search_user(user_id):

    con = get_db()

    user = con.execute(
        "SELECT simmiii_id FROM users WHERE simmiii_id=?",
        (user_id.upper(),)
    ).fetchone()

    con.close()

    if user:
        return jsonify({
            "found": True,
            "id": user["simmiii_id"]
        })

    return jsonify({
        "found": False
    })


# =========================
# SEND FRIEND REQUEST
# =========================

@app.route("/add_friend", methods=["POST"])
def add_friend():

    sender = request.form.get("sender")
    receiver = request.form.get("receiver")

    if not sender or not receiver:
        return jsonify({
            "success": False,
            "message": "ID missing"
        })

    if sender == receiver:
        return jsonify({
            "success": False,
            "message": "Apne aap ko add nahi kar sakte"
        })

    con = get_db()

    user = con.execute(
        "SELECT * FROM users WHERE simmiii_id=?",
        (receiver,)
    ).fetchone()

    if not user:
        con.close()

        return jsonify({
            "success": False,
            "message": "User nahi mila"
        })

    already = con.execute("""
        SELECT * FROM friends
        WHERE
        (user1=? AND user2=?)
        OR
        (user1=? AND user2=?)
    """, (
        sender,
        receiver,
        receiver,
        sender
    )).fetchone()

    if already:

        con.close()

        return jsonify({
            "success": False,
            "message": "Already friends"
        })


    pending = con.execute("""
        SELECT * FROM requests
        WHERE
        sender=? AND receiver=?
        AND status='pending'
    """, (
        sender,
        receiver
    )).fetchone()


    if pending:

        con.close()

        return jsonify({
            "success": False,
            "message": "Request already sent"
        })


    con.execute("""
        INSERT INTO requests
        (sender, receiver, status)
        VALUES (?, ?, 'pending')
    """, (
        sender,
        receiver
    ))

    con.commit()
    con.close()

    return jsonify({
        "success": True,
        "message": "Friend request sent"
    })


# =========================
# REQUESTS
# =========================

@app.route("/requests/<user_id>")
def requests(user_id):

    con = get_db()

    rows = con.execute("""
        SELECT * FROM requests
        WHERE receiver=? AND status='pending'
        ORDER BY id DESC
    """, (
        user_id
    )).fetchall()

    con.close()

    return jsonify([
        dict(x) for x in rows
    ])


# =========================
# ACCEPT REQUEST
# =========================

@app.route("/accept", methods=["POST"])
def accept():

    request_id = request.form.get("request_id")

    con = get_db()

    req = con.execute(
        "SELECT * FROM requests WHERE id=?",
        (request_id,)
    ).fetchone()

    if not req:

        con.close()

        return jsonify({
            "success": False
        })


    con.execute("""
        UPDATE requests
        SET status='accepted'
        WHERE id=?
    """, (
        request_id
    ))


    con.execute("""
        INSERT INTO friends
        (user1, user2)
        VALUES (?, ?)
    """, (
        req["sender"],
        req["receiver"]
    ))


    con.commit()
    con.close()

    return jsonify({
        "success": True
    })


# =========================
# FRIEND LIST
# =========================

@app.route("/friends/<user_id>")
def friend_list(user_id):

    con = get_db()

    rows = con.execute("""
        SELECT user1, user2
        FROM friends
        WHERE user1=? OR user2=?
        ORDER BY id DESC
    """, (
        user_id,
        user_id
    )).fetchall()

    con.close()

    result = []

    for row in rows:

        if row["user1"] == user_id:
            friend = row["user2"]
        else:
            friend = row["user1"]

        result.append({
            "id": friend
        })

    return jsonify(result)


# =========================
# SEND MESSAGE
# =========================

@app.route("/send_message", methods=["POST"])
def send_message():

    sender = request.form.get("sender")
    receiver = request.form.get("receiver")
    message = request.form.get("message", "")

    photo = ""

    if "photo" in request.files:

        file = request.files["photo"]

        if file.filename:

            filename = (
                uuid.uuid4().hex
                + "_"
                + file.filename
            )

            path = os.path.join(
                UPLOAD_FOLDER,
                filename
            )

            file.save(path)

            photo = "/uploads/" + filename


    con = get_db()

    con.execute("""
        INSERT INTO messages
        (sender, receiver, message, photo)
        VALUES (?, ?, ?, ?)
    """, (
        sender,
        receiver,
        message,
        photo
    ))

    con.commit()
    con.close()

    return jsonify({
        "success": True
    })


# =========================
# GET CHAT
# =========================

@app.route("/chat/<user1>/<user2>")
def chat(user1, user2):

    con = get_db()

    rows = con.execute("""
        SELECT *
        FROM messages
        WHERE
        (sender=? AND receiver=?)
        OR
        (sender=? AND receiver=?)
        ORDER BY id ASC
    """, (
        user1,
        user2,
        user2,
        user1
    )).fetchall()

    con.close()

    return jsonify([
        dict(x) for x in rows
    ])


