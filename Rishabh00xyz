@app.route("/create_group", methods=["POST"])
def create_group():

    name = request.form.get(
        "group_name",
        "My Group"
    )

    group_id = (
        "GRP-"
        + uuid.uuid4().hex[:8].upper()
    )

    con = database()

    con.execute("""
        INSERT INTO groups
        (group_id, group_name)
        VALUES (?, ?)
    """, (
        group_id,
        name
    ))

    con.commit()
    con.close()

    return jsonify({
        "success": True,
        "group_id": group_id,
        "name": name
    })


# =========================
# GROUP LIST
# =========================

@app.route("/groups")
def get_groups():

    con = database()

    groups = con.execute(
        "SELECT * FROM groups ORDER BY id DESC"
    ).fetchall()

    con.close()

    return jsonify([
        dict(x) for x in groups
    ])


