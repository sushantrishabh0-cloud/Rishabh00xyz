from flask import Flask, request, jsonify, render_template_string
import sqlite3
import uuid
import os

app = Flask(__name__)

DB = "simmiii.db"
UPLOADS = "uploads"

os.makedirs(UPLOADS, exist_ok=True)


# =========================
# DATABASE
# =========================

def database():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con


def setup_database():

    con = database()

    con.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            simmiii_id TEXT UNIQUE
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sender TEXT,
            receiver TEXT,
            message TEXT,
            photo TEXT
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS groups (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            group_id TEXT UNIQUE,
            group_name TEXT
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS group_messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            group_id TEXT,
            sender TEXT,
            message TEXT,
            photo TEXT
        )
    """)

    con.commit()
    con.close()


# =========================
# CREATE USER
# =========================

@app.route("/create_user")
def create_user():

    simmiii_id = "SIM-" + uuid.uuid4().hex[:8].upper()

    con = database()

    con.execute(
        "INSERT INTO users (simmiii_id) VALUES (?)",
        (simmiii_id,)
    )

    con.commit()
    con.close()

    return jsonify({
        "id": simmiii_id
    })


# =========================
# SEND MESSAGE
# =========================

@app.route("/send_message", methods=["POST"])
def send_message():

    sender = request.form.get("sender")
    receiver = request.form.get("receiver")
    message = request.form.get("message", "")

    photo = ""

    if "photo" in request.files:

        file = request.files["photo"]

        if file.filename:

            filename = (
                uuid.uuid4().hex
                + "_"
                + file.filename
            )

            path = os.path.join(
                UPLOADS,
                filename
            )

            file.save(path)

            photo = "/uploads/" + filename

    con = database()

    con.execute("""
        INSERT INTO messages
        (sender, receiver, message, photo)
        VALUES (?, ?, ?, ?)
    """, (
        sender,
        receiver,
        message,
        photo
    ))

    con.commit()
    con.close()

    return jsonify({
        "success": True
    })


# =========================
# GET CHAT
# =========================

@app.route("/chat/<sender>/<receiver>")
def get_chat(sender, receiver):

    con = database()

    messages = con.execute("""
        SELECT *
        FROM messages
        WHERE
        (sender = ? AND receiver = ?)
        OR
        (sender = ? AND receiver = ?)
        ORDER BY id ASC
    """, (
        sender,
        receiver,
        receiver,
        sender
    )).fetchall()

    con.close()

    return jsonify([
        dict(x) for x in messages
    ])


# =========================
# CREATE GROUP
